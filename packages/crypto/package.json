{
  "name": "@envvault/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "Envelope encryption and key management (AES-256-GCM, key provider interface, local development keyring). Server-side only.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@envvault/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
