{
  "name": "@envvault/sdk",
  "version": "0.2.0",
  "private": true,
  "description": "Typed TypeScript client for the EnvVault REST API, for people, the CLI and machine identities",
  "license": "UNLICENSED",
  "author": "EnvVault",
  "keywords": [
    "envvault",
    "secrets",
    "configuration",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cooleo273/EnvVault.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=20.3"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@envvault/shared": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@envvault/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
