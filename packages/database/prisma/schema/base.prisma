// EnvVault database schema (multi-file). See docs/database.md for the ERD,
// tenancy model and the constraints added in raw SQL migrations.
//
// Conventions
// - UUIDv7 primary keys (time-ordered, generated by Prisma Client).
// - snake_case tables/columns via @@map/@map; timestamps are timestamptz(3).
// - Tenant-owned rows carry workspace_id. Child rows reference their parent
//   through a composite FK (workspace_id, parent_id) -> parent(workspace_id, id)
//   so the database rejects cross-workspace references.
// - Intra-tenant references use ON DELETE NO ACTION (checked at end of
//   statement) instead of RESTRICT so a deliberate workspace purge can cascade.
// - Secret material is only ever stored as envelope-encrypted ciphertext.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthRevocationReason {
  LOGOUT
  LOGOUT_ALL_DEVICES
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
}

enum StepUpMethod {
  PASSWORD
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  /// The invitee declined.
  DECLINED
}

/// Lifecycle of a project. ARCHIVED projects are read-only until restored.
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Lifecycle of an environment. ARCHIVED environments are read-only until restored.
enum EnvironmentStatus {
  ACTIVE
  ARCHIVED
}

/// Presentation and onboarding hint; both kinds have the same security model.
enum WorkspaceType {
  PERSONAL
  TEAM
}

/// Where a role may be assigned.
enum RoleScope {
  WORKSPACE
  PROJECT
  ENVIRONMENT
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum EnvironmentKind {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
  OTHER
}

/// Expected format and presentation of a variable. Every value is encrypted
/// regardless of type; a type never permits plaintext storage.
enum SecretType {
  STRING
  SECRET
  BOOLEAN
  NUMBER
  JSON
  MULTILINE
}

/// How a secret version was created (history and rollback provenance).
enum SecretVersionOrigin {
  CREATE
  UPDATE
  IMPORT
  ROLLBACK
  /// Written by restoring an environment snapshot.
  RESTORE
}

/// Expected format of a variable's value in a validation rule.
enum ValueFormat {
  ANY
  URL
  JSON
  NUMBER
}

enum EnvironmentSnapshotStatus {
  /// Fully written and immutable.
  COMPLETE
}

enum EncryptionAlgorithm {
  AES_256_GCM
}

enum EncryptionKeyStatus {
  /// Used for new encryptions. At most one per workspace.
  ACTIVE
  /// Still able to decrypt existing data; awaiting re-wrap to the active key.
  DECRYPT_ONLY
  /// No longer referenced; kept for audit.
  RETIRED
}

enum ServiceIdentityStatus {
  ACTIVE
  DISABLED
}

enum CredentialType {
  /// Random bearer token; only a hash is stored.
  API_TOKEN
  /// Workload identity federation (e.g. CI OIDC tokens); no stored secret.
  OIDC_FEDERATION
}

enum ChangeRequestStatus {
  OPEN
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
  EXPIRED
}

enum SecretChangeOperation {
  CREATE
  UPDATE
  DELETE
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum AuditActorType {
  USER
  SERVICE_IDENTITY
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum IntegrationProvider {
  GITHUB
  GITLAB
  VERCEL
  NETLIFY
  AWS_SECRETS_MANAGER
  KUBERNETES
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  /// Some variables were written and some were not; the summary says which.
  PARTIAL
  FAILED
  CANCELLED
}

enum IntegrationTarget {
  DEVELOPMENT
  PREVIEW
  PRODUCTION
  CUSTOM
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  SECRET_CHANGED
}

enum RotationStrategy {
  /// Notify owners when the interval elapses.
  MANUAL_REMINDER
  /// Rotate through a connected integration.
  INTEGRATION
}
