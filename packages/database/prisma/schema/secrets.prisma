/// Reference to a workspace's KMS root key. Holds only an identifier (e.g. a
/// key ARN), never key material. Versions allow rotation: new data is
/// encrypted under the ACTIVE key and existing data keys are re-wrapped.
model EncryptionKey {
  id          String              @id @default(uuid(7)) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  /// Monotonic per workspace.
  version     Int
  kmsProvider String              @map("kms_provider") @db.VarChar(32)
  /// Provider-specific key identifier. Not secret, not key material.
  kmsKeyRef   String              @map("kms_key_ref") @db.VarChar(2048)
  status      EncryptionKeyStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  retiredAt   DateTime?           @map("retired_at") @db.Timestamptz(3)

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  secretVersions         SecretVersion[]
  changeRequestItems     ChangeRequestItem[]
  integrationConnections IntegrationConnection[]

  @@unique([workspaceId, version])
  @@unique([workspaceId, id])
  @@map("encryption_keys")
}

/// Secret metadata. The value lives exclusively in encrypted SecretVersion rows.
model Secret {
  id                         String     @id @default(uuid(7)) @db.Uuid
  workspaceId                String     @map("workspace_id") @db.Uuid
  projectId                  String     @map("project_id") @db.Uuid
  environmentId              String     @map("environment_id") @db.Uuid
  /// Environment variable name; unique per environment among live secrets.
  key                        String     @db.VarChar(256)
  description                String?    @db.VarChar(1000)
  type                       SecretType @default(SECRET)
  /// Free label for grouping (e.g. Database, Payments). Null when uncategorised.
  category                   String?    @db.VarChar(64)
  /// Lowercase labels for filtering; at most 20 (CHECK).
  tags                       String[]   @default([])
  /// The application expects this variable to be set.
  isRequired                 Boolean    @default(false) @map("is_required")
  /// Optimistic concurrency token. Every mutation increments it, and writers
  /// update only when it still matches the revision they read.
  revision                   Int        @default(1)
  /// Must reference a version of this same secret (composite FK).
  currentVersionId           String?    @unique @map("current_version_id") @db.Uuid
  /// Allocator for version numbers; incremented inside the write transaction.
  latestVersionNumber        Int        @default(0) @map("latest_version_number")
  /// Exactly one of the user/service-identity attribution columns is set.
  createdByUserId            String?    @map("created_by_user_id") @db.Uuid
  createdByServiceIdentityId String?    @map("created_by_service_identity_id") @db.Uuid
  updatedByUserId            String?    @map("updated_by_user_id") @db.Uuid
  updatedByServiceIdentityId String?    @map("updated_by_service_identity_id") @db.Uuid
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete: keeps version history recoverable until purge.
  deletedAt                  DateTime?  @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId            String?    @map("deleted_by_user_id") @db.Uuid

  environment              Environment           @relation(fields: [workspaceId, projectId, environmentId], references: [workspaceId, projectId, id], onDelete: Cascade, map: "secrets_environment_fkey")
  versions                 SecretVersion[]       @relation("SecretVersions")
  currentVersion           SecretVersion?        @relation("SecretCurrentVersion", fields: [id, currentVersionId], references: [secretId, id], onDelete: NoAction, onUpdate: NoAction, map: "secrets_current_version_fkey")
  createdByUser            User?                 @relation("SecretCreatedByUser", fields: [createdByUserId], references: [id], onDelete: NoAction)
  updatedByUser            User?                 @relation("SecretUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: NoAction)
  deletedByUser            User?                 @relation("SecretDeletedByUser", fields: [deletedByUserId], references: [id], onDelete: NoAction)
  createdByServiceIdentity ServiceIdentity?      @relation("SecretCreatedByServiceIdentity", fields: [workspaceId, createdByServiceIdentityId], references: [workspaceId, id], onDelete: NoAction, map: "secrets_created_by_service_identity_fkey")
  updatedByServiceIdentity ServiceIdentity?      @relation("SecretUpdatedByServiceIdentity", fields: [workspaceId, updatedByServiceIdentityId], references: [workspaceId, id], onDelete: NoAction, map: "secrets_updated_by_service_identity_fkey")
  rotationPolicy           SecretRotationPolicy?
  changeRequestItems       ChangeRequestItem[]

  @@unique([workspaceId, id])
  @@unique([id, currentVersionId])
  @@index([environmentId])
  @@index([workspaceId, projectId])
  @@map("secrets")
}

/// Immutable, envelope-encrypted value of a secret at a point in time
/// (see @envvault/crypto). Only the KMS-wrapped data key is stored. The
/// cryptographic payload cannot be modified after insert (trigger); only the
/// wrapped data key may be replaced when re-wrapping under a new root key.
model SecretVersion {
  id                         String              @id @default(uuid(7)) @db.Uuid
  workspaceId                String              @map("workspace_id") @db.Uuid
  secretId                   String              @map("secret_id") @db.Uuid
  versionNumber              Int                 @map("version_number")
  ciphertext                 Bytes
  /// 96-bit AES-GCM nonce.
  iv                         Bytes
  /// 128-bit AES-GCM authentication tag.
  authTag                    Bytes               @map("auth_tag")
  /// Data key encrypted by the KMS root key referenced by encryptionKeyId.
  encryptedDataKey           Bytes               @map("encrypted_data_key")
  algorithm                  EncryptionAlgorithm @default(AES_256_GCM)
  /// Envelope format version (EncryptedEnvelope.version).
  envelopeVersion            Int                 @default(1) @map("envelope_version")
  encryptionKeyId            String              @map("encryption_key_id") @db.Uuid
  /// Key version reported by the KMS, if any (for rotation bookkeeping).
  kmsKeyVersion              String?             @map("kms_key_version") @db.VarChar(255)
  rewrappedAt                DateTime?           @map("rewrapped_at") @db.Timestamptz(3)
  createdByUserId            String?             @map("created_by_user_id") @db.Uuid
  createdByServiceIdentityId String?             @map("created_by_service_identity_id") @db.Uuid
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  secret                   Secret           @relation("SecretVersions", fields: [workspaceId, secretId], references: [workspaceId, id], onDelete: Cascade, map: "secret_versions_secret_fkey")
  currentFor               Secret?          @relation("SecretCurrentVersion")
  encryptionKey            EncryptionKey    @relation(fields: [workspaceId, encryptionKeyId], references: [workspaceId, id], onDelete: NoAction, map: "secret_versions_encryption_key_fkey")
  createdByUser            User?            @relation("SecretVersionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: NoAction)
  createdByServiceIdentity ServiceIdentity? @relation("SecretVersionCreatedByServiceIdentity", fields: [workspaceId, createdByServiceIdentityId], references: [workspaceId, id], onDelete: NoAction, map: "secret_versions_created_by_service_identity_fkey")

  @@unique([secretId, versionNumber])
  @@unique([secretId, id])
  @@index([encryptionKeyId])
  @@map("secret_versions")
}

model SecretRotationPolicy {
  id                      String           @id @default(uuid(7)) @db.Uuid
  workspaceId             String           @map("workspace_id") @db.Uuid
  secretId                String           @map("secret_id") @db.Uuid
  strategy                RotationStrategy @default(MANUAL_REMINDER)
  intervalDays            Int              @map("interval_days")
  integrationConnectionId String?          @map("integration_connection_id") @db.Uuid
  isEnabled               Boolean          @default(true) @map("is_enabled")
  lastRotatedAt           DateTime?        @map("last_rotated_at") @db.Timestamptz(3)
  nextRotationAt          DateTime?        @map("next_rotation_at") @db.Timestamptz(3)
  createdById             String?          @map("created_by_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  secret                Secret                 @relation(fields: [workspaceId, secretId], references: [workspaceId, id], onDelete: Cascade, map: "secret_rotation_policies_secret_fkey")
  integrationConnection IntegrationConnection? @relation(fields: [workspaceId, integrationConnectionId], references: [workspaceId, id], onDelete: NoAction, map: "secret_rotation_policies_integration_fkey")
  createdBy             User?                  @relation("RotationPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, secretId])
  @@index([isEnabled, nextRotationAt])
  @@index([integrationConnectionId])
  @@map("secret_rotation_policies")
}
