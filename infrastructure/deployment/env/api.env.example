# API runtime configuration. Copy to api.env on the host (mode 0600), fill in,
# and never commit the copy. Values here are placeholders.
NODE_ENV=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000

# Neon pooled connection string (TLS required).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_CONNECT_TIMEOUT_MS=10000

CORS_ORIGINS=https://app.example.com
APP_BASE_URL=https://app.example.com
AUTH_TRUSTED_ORIGIN=https://app.example.com
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth

# Self-managed keys (see docs/key-management.md for what this does not protect against).
ENCRYPTION_PROVIDER=local
ENCRYPTION_KEYRING_FILE=/run/envvault/keys/keyring.json
ENCRYPTION_SELF_MANAGED_ACKNOWLEDGED=true
INTEGRITY_KEY_FILE=/run/envvault/keys/integrity.json

RATE_LIMIT_STORE=redis
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379
