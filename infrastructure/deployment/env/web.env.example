# Web runtime configuration. Copy to web.env (mode 0600) and fill in.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-32-random-bytes
APP_BASE_URL=https://app.example.com
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_API_URL=https://app.example.com
