# ---------------------------------------------------------------
# Secrets & local environment files — NEVER commit these.
# Only *.example templates (placeholders only) are tracked.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json
*.secret
*.secrets
secrets/
.secrets/
# Source code folders named after the feature (code only, never secret material).
!apps/api/src/secrets/
!apps/web/src/features/secrets/
.envrc
.npmrc.local
# Development key material (pnpm crypto:init:dev)
.envvault/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.next-e2e/
*.tsbuildinfo
next-env.d.ts

# Generated code
packages/database/src/generated/

# Tooling caches
.turbo/
.eslintcache
coverage/
.vitest/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Docker local volumes
infrastructure/docker/data/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Playwright auth state (contains test session cookies)
apps/web/e2e-auth/.auth/

# Phase 3E key material and operator files: never commit.
*keyring*.json
recovery-key*.json
*recovery*.key.json
*keyring-backup*.json
integrity*.json
infrastructure/deployment/env/*.env

# Python (packages/sdk-python)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
