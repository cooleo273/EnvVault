{
  "name": "@envvault/cli",
  "version": "0.0.0",
  "private": true,
  "description": "EnvVault command-line interface",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "envvault": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@envvault/sdk": "workspace:*"
  },
  "devDependencies": {
    "@envvault/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
