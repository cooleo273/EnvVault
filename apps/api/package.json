{
  "name": "@envvault/api",
  "version": "0.0.0",
  "private": true,
  "description": "EnvVault REST API (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:integration": "vitest run --config vitest.config.integration.ts"
  },
  "dependencies": {
    "@envvault/crypto": "workspace:*",
    "@envvault/database": "workspace:*",
    "@envvault/shared": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@envvault/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
