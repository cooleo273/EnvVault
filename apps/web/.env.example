# Frontend environment (placeholders only — never commit real values).
# NEXT_PUBLIC_* variables are embedded in the browser bundle: never put secrets in them.

# Public origin of the EnvVault API (used for the Content-Security-Policy connect-src).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only values (NEON_AUTH_BASE_URL, NEON_AUTH_COOKIE_SECRET, APP_BASE_URL,
# API_INTERNAL_URL) are read from the repository root .env in development.
# See ../../.env.example and docs/authentication.md.
