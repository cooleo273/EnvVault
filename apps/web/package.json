{
  "name": "@envvault/web",
  "version": "0.0.0",
  "private": true,
  "description": "EnvVault web application (Next.js App Router)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts"
  },
  "dependencies": {
    "@envvault/sdk": "workspace:*",
    "@envvault/shared": "workspace:*",
    "@neondatabase/auth": "0.6.0-beta",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@envvault/config": "workspace:*",
    "@envvault/database": "workspace:*",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.6",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
