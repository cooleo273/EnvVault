# -----------------------------------------------------------------------------
# EnvVault local development configuration
#
#   cp .env.example .env
#
# This file contains PLACEHOLDERS ONLY. Never commit .env or real credentials.
# The values below are for a disposable local Docker setup; replace every
# "change-me" value with your own before starting the infrastructure.
# -----------------------------------------------------------------------------

# --- Local infrastructure (Docker Compose) -----------------------------------
POSTGRES_USER=envvault
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=envvault
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-local-redis-password
REDIS_PORT=6379

# --- API (apps/api) ----------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# Must match the POSTGRES_* values above when using the local Docker database.
# With Neon: the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL=postgresql://envvault:change-me-local-postgres-password@localhost:5432/envvault?schema=public

# Optional. Used by the Prisma CLI (migrate, seed) instead of DATABASE_URL.
# With Neon: the DIRECT (non-pooled) connection string of the SAME branch.
# Leave unset for the local Docker database.
# DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Comma-separated, exact browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Stricter per-minute limit for invitation-token endpoints (per client).
# RATE_LIMIT_SENSITIVE_MAX=20

# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Reserved: Redis is provisioned locally but not consumed by the API until a
# later phase (distributed rate limiting, queues, caching).
REDIS_URL=redis://:change-me-local-redis-password@localhost:6379

# --- Authentication: Neon Auth (see docs/authentication.md) ----------------
# Each Neon branch has its own Auth URL, users and sessions. Use a separate
# branch (and separate secrets) for development and production.
# Neon Console -> your branch -> Auth -> Configuration -> "Auth URL".
NEON_AUTH_BASE_URL=https://<endpoint-id>.neonauth.<region>.aws.neon.tech/<database>/auth

# Web only: signs the short-lived session-data cookie. Generate per environment:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=change-me-generate-with-openssl-rand-base64-32

# Public origin of the web app. Web: password-reset links point here and it
# must be a trusted domain in Neon Auth (localhost is trusted by default).
# API: invitation links (<APP_BASE_URL>/invite#token=...). Default: first CORS origin.
APP_BASE_URL=http://localhost:3000

# Web only: API origin reachable from the Next.js server (defaults to NEXT_PUBLIC_API_URL).
# API_INTERNAL_URL=http://localhost:4000

# API only, all optional. Defaults shown.
# JWKS endpoint; must share NEON_AUTH_BASE_URL's origin. Default: <NEON_AUTH_BASE_URL>/.well-known/jwks.json
# NEON_AUTH_JWKS_URL=
# Expected JWT "aud". Default: origin of NEON_AUTH_BASE_URL (what Neon issues).
# NEON_AUTH_AUDIENCE=
# Rejects tokens older than this even if "exp" is later (Neon issues 15-minute JWTs).
# AUTH_MAX_TOKEN_AGE_SECONDS=900
# AUTH_CLOCK_TOLERANCE_SECONDS=5
# Lifetime of a password re-verification ("step-up") for sensitive actions (60-3600).
# AUTH_STEP_UP_TTL_SECONDS=600
# Origin the API sends to Neon Auth when re-verifying a password. Must be a
# trusted domain in Neon Auth. Default: first CORS_ORIGINS entry.
# AUTH_TRUSTED_ORIGIN=http://localhost:3000

# --- Workspaces and invitations (API) -----------------------------------------
# Invitation lifetime in hours (1-720). Default 168 (7 days).
# INVITATION_TTL_HOURS=168
# Outbound email. Only "none" exists: invitations are NOT emailed; the inviter
# gets a one-time link to share instead, and the UI says so.
# EMAIL_PROVIDER=none

# Disposable database for `pnpm test:integration` (created by the Docker init
# script). The test setup DROPS this schema and only accepts names containing "test".
TEST_DATABASE_URL=postgresql://envvault:change-me-local-postgres-password@localhost:5432/envvault_test?schema=public

# Disposable database for `pnpm test:e2e:auth` (reset before every run; name must
# contain "test"). Never point this or TEST_DATABASE_URL at a Neon branch with real data.
# E2E_DATABASE_URL=postgresql://envvault:change-me-local-postgres-password@localhost:5432/envvault_e2e_test?schema=public

# --- Web (apps/web) ----------------------------------------------------------
# Public values only: NEXT_PUBLIC_* variables are shipped to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Envelope encryption (API only; see docs/key-management.md) --------------
# "none" (default): encryption disabled. The API never generates keys by itself.
# "local": self-managed DEVELOPMENT keyring. Refused when NODE_ENV=production;
# it is not a substitute for a managed or hardware-backed KMS.
# ENCRYPTION_PROVIDER=none
#
# Create the keyring with `pnpm crypto:init:dev` (writes .envvault/dev-keyring.json,
# gitignored, never printed) and set its ABSOLUTE path here. Back the file up:
# losing it makes every secret encrypted with it permanently unrecoverable.
# ENCRYPTION_KEYRING_FILE=/absolute/path/to/EnvVault/.envvault/dev-keyring.json
#
# Alternative to the file: base64 of the keyring JSON as a server-side secret.
# Never a NEXT_PUBLIC_* variable. Rotation requires the file form.
# ENCRYPTION_LOCAL_KEYRING=
