{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "PRISMA_HIDE_UPDATE_MESSAGE",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!.env*", ".env.example"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_*",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "LOG_LEVEL",
        "RATE_LIMIT_*",
        "TRUST_PROXY",
        "NEXT_PUBLIC_*",
        "NEON_AUTH_*",
        "AUTH_*",
        "APP_BASE_URL",
        "ENCRYPTION_*"
      ]
    },
    "clean": {
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "@envvault/web#test:e2e:auth": {
      "dependsOn": ["^build", "@envvault/api#build"],
      "cache": false,
      "passThroughEnv": ["E2E_DATABASE_URL"]
    }
  }
}
